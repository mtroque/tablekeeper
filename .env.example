# Copy to .env.local for local development. Never commit real values.
# Both apps validate their variables with Zod at startup.
# Hosting: Vercel takes every variable under "Web", Render every variable under "API" (docs/DEPLOYMENT.md).

# ---------- Web ----------
# apps/web. Locally the two NEXT_PUBLIC_SUPABASE_* values are left unset: `pnpm dev` fills them from
# `supabase status -o env` while local Supabase is running. Explicit values always win.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000   # overridden by `pnpm dev` when ports are picked automatically
NEXT_PUBLIC_ENABLE_EXAMPLE_GAME=false
NEXT_PUBLIC_ENABLE_PHOTO_SCORING=false     # photo buttons stay disabled until S4 (docs/slices/S4-cv-worker-detectors.md)

# ---------- API ----------
# apps/api.
NODE_ENV=development
WEB_ORIGINS=http://localhost:3000           # overridden by `pnpm dev` when ports are picked automatically
LOG_LEVEL=info

# Supabase. Locally leave these unset: `pnpm dev`, tests and scripts fill them from
# `supabase status -o env` while local Supabase is running. Explicit values always win.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# LLM
LLM_ENABLED=true
LLM_PROVIDER=anthropic            # anthropic | fake
ANTHROPIC_API_KEY=
LLM_MODEL_RULES=                  # set to a current Claude model id
RULES_MAX_TOOL_CALLS=6
RULES_MAX_OUTPUT_TOKENS=800

# Quotas (per UTC day)
LLM_GUEST_DAILY_REQUESTS=5
LLM_USER_DAILY_REQUESTS=30
LLM_GLOBAL_DAILY_REQUESTS=500
LLM_GLOBAL_DAILY_TOKENS=2000000
IP_HASH_SALT=change-me

# Burst limit for /v1 routes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ---------- Local only ----------
# Never set on Vercel or Render.

# Ports. Leave unset: `pnpm dev` picks the first free ports from 3000 / 4000 and sets
# NEXT_PUBLIC_API_URL and WEB_ORIGINS to match, so worktrees never collide.
# WEB_PORT=3000
# API_PORT=4000

# Google OAuth for local Supabase Auth (from your Google Cloud OAuth client). In production the
# client ID and secret go into the Supabase dashboard instead (docs/DEPLOYMENT.md).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
