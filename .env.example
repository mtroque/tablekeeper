# Copy to .env.local for local development. Never commit real values.
# Both apps validate their variables with Zod at startup.
# Hosting: two Vercel projects. The web project takes every variable under "Web", the API project
# every variable under "API" (docs/DEPLOYMENT.md).

# ---------- Web ----------
# apps/web. Locally NEXT_PUBLIC_NEON_AUTH_URL defaults to a local stub; set it to your Neon
# Auth URL if testing real Google sign-in locally.
# NEXT_PUBLIC_NEON_AUTH_URL=
NEXT_PUBLIC_API_URL=http://localhost:4000   # overridden by `pnpm dev` when ports are picked automatically
NEXT_PUBLIC_ENABLE_EXAMPLE_GAME=false
NEXT_PUBLIC_ENABLE_PHOTO_SCORING=true      # false hides the photo buttons (D-055)

# ---------- API ----------
# apps/api.
NODE_ENV=development
WEB_ORIGINS=http://localhost:3000           # overridden by `pnpm dev` when ports are picked automatically
LOG_LEVEL=info

# Database and Neon Auth. Locally leave these unset: `pnpm dev`, tests and scripts fill local
# Docker Postgres and test-auth defaults. Explicit values always win.
# DATABASE_URL=
# NEON_AUTH_BASE_URL=

# LLM
LLM_ENABLED=true
LLM_PROVIDER=anthropic            # anthropic | fake
ANTHROPIC_API_KEY=
LLM_MODEL_RULES=                  # set to a current Claude model id
RULES_MAX_TOOL_CALLS=6
RULES_MAX_OUTPUT_TOKENS=800

# Quotas (per UTC day)
LLM_GUEST_DAILY_REQUESTS=5
LLM_USER_DAILY_REQUESTS=30
LLM_GLOBAL_DAILY_REQUESTS=500
LLM_GLOBAL_DAILY_TOKENS=2000000
IP_HASH_SALT=change-me

# Burst limit for /v1 routes
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
# Where the burst limit counts: database (shared by every serverless instance) or memory (one
# process). Leave unset: database in production, memory elsewhere.
# RATE_LIMIT_STORE=

# ---------- Local only ----------
# Never set on Vercel.

# Ports. Leave unset: `pnpm dev` picks the first free ports from 3000 / 4000 and sets
# NEXT_PUBLIC_API_URL and WEB_ORIGINS to match, so worktrees never collide.
# WEB_PORT=3000
# API_PORT=4000
